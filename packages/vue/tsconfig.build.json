{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist",
    "rootDir": "./src",
    "types": ["vite/client"]
  },
  "include": ["src/index.ts", "src/rich-text/**/*.ts", "src/rich-text/**/*.vue"],
  "exclude": ["src/**/__tests__/**", "src/test-setup.ts"]
}
