{
  "name": "@eldrajs/ui",
  "version": "0.2.9",
  "description": "Accessible Vue 3 core components for Eldra storefronts: buttons, forms, selects, cards, overlays and navigation, themed through CSS design tokens.",
  "keywords": [
    "accessible",
    "components",
    "eldra",
    "storefront",
    "tailwind",
    "vue"
  ],
  "homepage": "https://github.com/eldra-is/headless-kit/tree/main/packages/ui#readme",
  "bugs": "https://github.com/eldra-is/headless-kit/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eldra-is/headless-kit.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-tabler-icons"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js"
    },
    "./vee-validate": {
      "types": "./dist/vee-validate/index.d.ts",
      "import": "./dist/vee-validate.js"
    },
    "./vue-i18n": {
      "types": "./dist/vue-i18n/index.d.ts",
      "import": "./dist/vue-i18n.js"
    },
    "./messages/is-IS": {
      "types": "./dist/messages/is-IS.d.ts",
      "import": "./dist/messages/is-IS.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./style.css": "./dist/style.css",
    "./components.css": "./dist/components.css",
    "./scoped.css": "./dist/scoped.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build-tokens.mjs && vite build && node scripts/fix-dts.mjs && node scripts/copy-css.mjs",
    "build-tokens": "node scripts/build-tokens.mjs",
    "check:tokens": "node scripts/build-tokens.mjs --check",
    "build-tabler-icons": "node scripts/build-tabler-icons.mjs",
    "check:tabler-icons": "node scripts/build-tabler-icons.mjs --check",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src scripts",
    "test": "vitest run",
    "storybook": "storybook dev -p 6008 --no-open",
    "build-storybook": "storybook build",
    "screenshots": "node scripts/screenshots.mjs",
    "drag-smoke": "node scripts/drag-smoke.mjs"
  },
  "dependencies": {
    "@eldrajs/sdk": "workspace:^",
    "@floating-ui/vue": "^1.1.5",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "^10.2.19",
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/vue3-vite": "^10.2.19",
    "@tabler/icons-vue": "3.48.0",
    "@tailwindcss/node": "^4.1.14",
    "@tailwindcss/oxide": "^4.1.14",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^21.0.4",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "storybook": "^10.2.19",
    "tailwindcss": "^4.1.14",
    "vee-validate": "^4.15.0",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^5.1.0",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.30",
    "vue-i18n": "^11.4.16",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "vee-validate": "^4.12.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "vee-validate": {
      "optional": true
    },
    "vue-i18n": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
