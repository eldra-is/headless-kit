{
  "name": "@eldrajs/sdk",
  "version": "0.3.2",
  "description": "Framework-free client for the Eldra Web Studio public storefront API: CMS, catalog, cart, checkout handoff, orders, inventory. Types generated from your gateway's OpenAPI document and CMS schemas at build time.",
  "keywords": [
    "cms",
    "commerce",
    "eldra",
    "headless",
    "sdk",
    "storefront"
  ],
  "homepage": "https://github.com/eldra-is/headless-kit/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/eldra-is/headless-kit/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eldra-is/headless-kit.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    },
    "./format/date": {
      "types": "./dist/format/date.d.ts",
      "import": "./dist/format/date.js"
    },
    "./format/list": {
      "types": "./dist/format/list.d.ts",
      "import": "./dist/format/list.js"
    },
    "./format/relative-time": {
      "types": "./dist/format/relative-time.d.ts",
      "import": "./dist/format/relative-time.js"
    },
    "./format/display-names": {
      "types": "./dist/format/display-names.d.ts",
      "import": "./dist/format/display-names.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.generated.json",
    "test": "vitest run",
    "fixture": "node scripts/fixture.mjs",
    "format-data": "node scripts/extract-format-data.mjs",
    "check:format-data": "node scripts/extract-format-data.mjs --check"
  },
  "dependencies": {
    "openapi-typescript": "^7.13.0"
  },
  "devDependencies": {
    "@formatjs/intl-datetimeformat": "7.8.1",
    "@formatjs/intl-displaynames": "7.3.15",
    "@formatjs/intl-listformat": "8.3.15",
    "@formatjs/intl-numberformat": "9.4.3",
    "@formatjs/intl-relativetimeformat": "12.3.15",
    "@playwright/test": "1.62.1",
    "vite": "^8.0.8"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
