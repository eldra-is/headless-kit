{
  "name": "@eldra-is/sdk",
  "version": "0.0.0",
  "description": "Framework-free client for the Eldra Web Studio public storefront API: CMS, catalog, cart, checkout handoff, orders, inventory. Types generated from the versioned public contract.",
  "keywords": [
    "cms",
    "commerce",
    "eldra",
    "headless",
    "sdk",
    "storefront"
  ],
  "homepage": "https://github.com/eldra-is/headless-kit/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/eldra-is/headless-kit/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eldra-is/headless-kit.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "contract": "node scripts/contract.mjs",
    "contract:check": "node scripts/contract.mjs --check"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "vite": "^8.0.8"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
