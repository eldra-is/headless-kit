    "@eldrajs/theme-nuxt": "workspace:*",
    "@eldrajs/theme-vue": "workspace:*",
    "@eldrajs/ui": "workspace:*",
    "@tabler/icons": "^3.34.0",
    "nuxt": "^4.0.0",
    "vue-i18n": "11.4.13"
  },
  "devDependencies": {
    "@eldrajs/theme-cli": "workspace:*",
    "@eldrajs/vite-plugin-theme": "workspace:*",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/vue3-vite": "^10.6.2",
    "@tailwindcss/node": "^4.1.14",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "execa": "^10.2.0",
    "jsdom": "^30.1.3",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.1.14",
