    {
      "apiId": "split-content",
      "id": "home-split-content",
      "data": {
        "startWith": "image-left",
        "rows": [
          {
            "image": {
              "assetId": "demo-split-1",
              "url": "/demo/split-1.svg",
              "altText": "A potter trimming a bowl on the wheel",
              "width": 1600,
              "height": 1200
            },
            "eyebrow": "The studio",
            "heading": "Every bowl passes through six pairs of hands",
            "text": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Our Portland potters throw, trim, glaze and fire in small batches of forty. Slight differences in speckle and rim are the mark of that process, not a flaw."
                    }
                  ]
                }
              ]
            },
            "linkLabel": "Inside the studio",
            "href": "/pages/studio"
          },
          {
            "image": {
              "assetId": "demo-split-2",
              "url": "/demo/split-2.svg",
              "altText": "Vintage knitting frame mid-row",
              "width": 1600,
              "height": 1200
            },
            "eyebrow": "The mill",
            "heading": "Knitted slowly, so it lasts",
            "text": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Our sweaters are knitted on vintage frames at a third of the usual speed. The tighter stitch holds its shape through ten winters or more."
                    }
                  ]
                }
              ]
            },
            "linkLabel": "Visit the mill",
            "href": "/pages/mill"
          }
        ]
      }
