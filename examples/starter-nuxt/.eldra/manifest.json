{
  "manifestVersion": 1,
  "theme": {
    "name": "starter-nuxt",
    "version": "0.1.0",
    "framework": "nuxt",
    "sdk": {
      "core": "0.0.0",
      "vitePlugin": "0.0.0"
    }
  },
  "blocks": [
    {
      "apiId": "announcement-bar",
      "name": "Announcement bar",
      "description": "A slim strip above the header for one short store-wide message, with an optional link and an optional dismiss button.",
      "icon": "speakerphone",
      "category": "structure",
      "version": 1,
      "fields": [
        {
          "fieldId": "variant",
          "name": "Variant",
          "type": "select",
          "helpText": "primary is the default.",
          "metadata": {
            "options": [
              "primary",
              "accent",
              "subtle"
            ]
          },
          "validators": {
            "required": true
          }
        },
        {
          "fieldId": "message",
          "name": "Message",
          "type": "string",
          "isTitle": true,
          "localized": true,
          "helpText": "One sentence, ideally under 60 characters.",
          "validators": {
            "required": true,
            "maxLength": 160
          }
        },
        {
          "fieldId": "linkLabel",
          "name": "Link label",
          "type": "string",
          "localized": true
        },
        {
          "fieldId": "linkHref",
          "name": "Link URL",
          "type": "string"
        },
        {
          "fieldId": "dismissable",
          "name": "Dismissable",
          "type": "bool",
          "default": true,
          "helpText": "Shows the dismiss button. The dismissal is remembered for the visitor, keyed to this message."
        }
      ],
      "mock": {
        "variant": "primary",
        "message": "Free shipping on orders over $80",
        "linkLabel": "Details",
        "linkHref": "/pages/shipping",
        "dismissable": true
      },
      "previewImage": ".eldra/previews/announcement-bar.png"
    },
    {
      "apiId": "article",
      "name": "Article",
      "description": "Long-form rich text with a heading, meta line and lead paragraph.",
      "icon": "article",
      "category": "content",
      "version": 1,
      "fields": [
        {
          "fieldId": "heading",
          "name": "Heading",
          "type": "string",
          "isTitle": true,
          "localized": true,
          "validators": {
            "required": true
          }
        },
        {
          "fieldId": "meta",
          "name": "Meta line",
          "type": "string",
          "localized": true
        },
        {
          "fieldId": "lead",
          "name": "Lead paragraph",
          "type": "text",
          "localized": true
        },
        {
          "fieldId": "body",
          "name": "Body",
          "type": "rich-text",
          "localized": true,
          "validators": {
            "required": true
          },
          "metadata": {
            "toolbar": [
              "heading",
              "bold",
              "italic",
              "link",
              "bulletList",
              "orderedList",
              "blockquote",
              "codeBlock",
              "image"
            ]
          }
        },
        {
          "fieldId": "width",
          "name": "Width",
          "type": "select",
          "metadata": {
            "options": [
              "narrow",
              "content"
            ]
          }
        }
      ],
      "mock": {
        "heading": "How we choose our wool",
        "meta": "By the Northwind Goods team — March 2024",
        "lead": "Every throw starts as a conversation with a mill, not a spreadsheet. Here's what we actually look for.",
        "width": "narrow",
        "body": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "We work with three small mills, each chosen for the same reason: they can tell us exactly which farm a fleece came from. "
                },
                {
                  "type": "text",
                  "text": "Traceability",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " isn't a marketing word for us — it's the difference between a throw you keep for a decade and one you don't."
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 2
              },
              "content": [
                {
                  "type": "text",
                  "text": "What we look for"
                }
              ]
            },
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Fibre length and crimp, checked by hand"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "A mill that pays shearers a fair, published rate"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Undyed lots we can dye small-batch ourselves"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "blockquote",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "If we can't tell you which valley it came from, we don't buy it."
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "That standard costs more up front. It also means a Northwind throw looks the same in year five as it did on day one."
                }
              ]
            }
          ]
        }
      },
      "previewImage": ".eldra/previews/article.png"
    },
    {
      "apiId": "breadcrumbs",
      "name": "Breadcrumbs",
      "description": "Trail from Home to the current page. The design spec builds this from the page tree, but a block cannot read the route (no Nuxt globals, and `useEldraPage()` is page-level) — `trail` is the theme's stand-in: fill it per page from the parent levels above this one.",
      "icon": "chevrons-right",
      "category": "structure",
      "version": 1,
      "fields": [
        {
          "fieldId": "showHome",
          "name": "Show home",
          "type": "bool",
          "default": true,
          "description": "First crumb links to /."
        },
        {
          "fieldId": "homeLabel",
          "name": "Home label",
          "type": "string",
          "localized": true,
          "default": "Home"
        },
        {
          "fieldId": "trail",
          "name": "Trail",
          "type": "list",
          "description": "The levels between Home and this page, root first. Not editable from the page tree — fill it by hand per page.",
          "metadata": {
            "item": {
              "fieldId": "item",
              "name": "Level",
              "type": "composite",
              "metadata": {
                "fields": [
                  {
                    "fieldId": "label",
                    "name": "Label",
                    "type": "string",
                    "localized": true,
                    "validators": {
                      "required": true
                    }
                  },
                  {
                    "fieldId": "href",
                    "name": "Link",
                    "type": "string",
                    "validators": {
                      "required": true
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "fieldId": "currentTitle",
          "name": "Current page title",
          "type": "string",
          "localized": true,
          "description": "Overrides the last crumb's text — use it for long product or article titles."
        },
        {
          "fieldId": "showCurrent",
          "name": "Show current page",
          "type": "bool",
          "default": true,
          "description": "Off ends the trail at the parent."
        },
        {
          "fieldId": "container",
          "name": "Container",
          "type": "select",
          "metadata": {
            "options": [
              "wide",
              "content"
            ]
          },
          "description": "Match the block below: use content above Product detail and Article so the trail lines up with the gallery or title edge."
        }
      ],
      "mock": {
        "showHome": true,
        "homeLabel": "Home",
        "trail": [
          {
            "label": "Knitwear",
            "href": "/collections/knitwear"
          },
          {
            "label": "Sweaters",
            "href": "/collections/mens-sweaters"
          }
        ],
        "currentTitle": "Merino crew sweater",
        "showCurrent": true,
        "container": "wide"
      },
      "previewImage": ".eldra/previews/breadcrumbs.png"
    },
    {
      "apiId": "cta",
      "name": "Call to action",
      "description": "Banner with heading, supporting copy and one or two buttons.",
      "icon": "hand-click",
      "category": "marketing",
      "version": 1,
      "fields": [
        {
          "fieldId": "heading",
          "name": "Heading",
          "type": "string",
          "isTitle": true,
          "localized": true,
          "validators": {
            "required": true
          }
        },
        {
          "fieldId": "body",
          "name": "Body",
          "type": "text",
          "localized": true
        },
        {
          "fieldId": "buttonLabel",
          "name": "Button label",
          "type": "string",
          "localized": true,
          "validators": {
            "required": true
          }
        },
        {
          "fieldId": "buttonHref",
          "name": "Button link",
          "type": "string",
          "validators": {
            "required": true
          }
        },
        {
          "fieldId": "secondaryButtonLabel",
          "name": "Secondary button label",
          "type": "string",
          "localized": true
        },
        {
          "fieldId": "secondaryButtonHref",
          "name": "Secondary button link",
          "type": "string"
        },
        {
          "fieldId": "variant",
          "name": "Variant",
          "type": "select",
          "metadata": {
            "options": [
              "primary",
              "subtle",
              "split"
            ]
          }
        }
      ],
      "mock": {
        "heading": "Free shipping over $75",
        "body": "Every order ships carbon-neutral, with easy 30-day returns.",
        "buttonLabel": "Start shopping",
        "buttonHref": "/shop",
        "secondaryButtonLabel": "Shipping & returns",
        "secondaryButtonHref": "/shipping-returns",
        "variant": "primary"
      },
      "previewImage": ".eldra/previews/cta.png"
    },
    {
      "apiId": "faq",
      "name": "FAQ",
      "description": "Frequently asked questions as disclosure widgets.",
      "icon": "help-circle",
      "category": "content",
      "version": 1,
      "fields": [
        {
          "fieldId": "heading",
          "name": "Heading",
          "type": "string",
          "isTitle": true,
          "localized": true,
          "validators": {
            "required": true
          }
        },
        {
          "fieldId": "intro",
          "name": "Intro",
          "type": "text",
          "localized": true
        },
        {
          "fieldId": "single",
          "name": "Only one open at a time",
          "type": "bool"
        },
        {
          "fieldId": "items",
          "name": "Questions",
          "type": "list",
          "metadata": {
            "item": {
              "fieldId": "item",
              "name": "Question",
              "type": "composite",
              "metadata": {
                "fields": [
                  {
                    "fieldId": "question",
                    "name": "Question",
                    "type": "string",
                    "localized": true,
                    "validators": {
                      "required": true
                    }
                  },
                  {
                    "fieldId": "answer",
                    "name": "Answer",
                    "type": "rich-text",
                    "localized": true,
                    "validators": {
                      "required": true
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "mock": {
        "heading": "Frequently asked questions",
        "intro": "Can't find what you're looking for? Reach out and a real person will get back to you within a day.",
        "single": true,
        "items": [
          {
            "question": "How long does shipping take?",
            "answer": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Orders ship within two business days and arrive in 3–5 days for most of the country. You'll get a tracking link by email the moment it leaves our workshop."
                    }
                  ]
                }
              ]
            }
          },
          {
            "question": "What's your returns policy?",
            "answer": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "We accept returns within 30 days of delivery, no questions asked. Items should be unused and in their original packaging."
                    }
                  ]
                }
              ]
            }
          },
          {
            "question": "Do you ship internationally?",
            "answer": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Yes — we currently ship to Canada, the UK and the EU. Rates and delivery times are calculated at checkout."
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "previewImage": ".eldra/previews/faq.png"
    },
