{
  "manifestVersion": 1,
  "theme": {
    "name": "starter-nuxt",
    "version": "0.1.0",
    "framework": "nuxt",
    "sdk": {
      "core": "0.0.0",
      "vitePlugin": "0.0.0"
    }
  },
  "blocks": [
    {
      "apiId": "article",
      "name": "Article",
      "description": "Long-form rich text with title, author and cover image.",
      "icon": "article",
      "category": "content",
      "version": 1,
      "fields": [
        {
          "fieldId": "title",
          "name": "Title",
          "type": "string",
          "isTitle": true,
          "localized": true,
          "validators": {
            "required": true
          }
        },
        {
          "fieldId": "author",
          "name": "Author",
          "type": "string"
        },
        {
          "fieldId": "coverImage",
          "name": "Cover image",
          "type": "media",
          "metadata": {
            "multiple": false
          }
        },
        {
          "fieldId": "body",
          "name": "Body",
          "type": "rich-text",
          "localized": true,
          "validators": {
            "required": true
          },
          "metadata": {
            "toolbar": [
              "heading",
              "bold",
              "italic",
              "link",
              "bulletList",
              "orderedList",
              "blockquote"
            ]
          }
        }
      ],
      "mock": {
        "title": "Announcing our new platform",
        "author": "Jane Doe",
        "body": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Body copy rendered from rich text."
                }
              ]
            }
          ]
        }
      },
      "previewImage": ".eldra/previews/article.png"
    },
    {
      "apiId": "cta",
      "name": "Call to action",
      "description": "Banner with heading, supporting copy and one or two buttons.",
      "icon": "hand-click",
      "category": "marketing",
      "version": 1,
      "fields": [
        {
          "fieldId": "heading",
          "name": "Heading",
          "type": "string",
          "isTitle": true,
          "localized": true,
          "validators": {
            "required": true
          }
        },
        {
          "fieldId": "body",
          "name": "Body",
          "type": "text",
          "localized": true
        },
        {
          "fieldId": "buttonLabel",
          "name": "Button label",
          "type": "string",
          "localized": true,
          "validators": {
            "required": true
          }
        },
        {
          "fieldId": "buttonHref",
          "name": "Button link",
          "type": "string",
          "validators": {
            "required": true
          }
        },
        {
          "fieldId": "secondaryButtonLabel",
          "name": "Secondary button label",
          "type": "string",
          "localized": true
        },
        {
          "fieldId": "secondaryButtonHref",
          "name": "Secondary button link",
          "type": "string"
        },
        {
          "fieldId": "variant",
          "name": "Variant",
          "type": "select",
          "metadata": {
            "options": [
              "primary",
              "subtle",
              "split"
            ]
          }
        }
      ],
      "mock": {
        "heading": "Free shipping over $75",
        "body": "Every order ships carbon-neutral, with easy 30-day returns.",
        "buttonLabel": "Start shopping",
        "buttonHref": "/shop",
        "secondaryButtonLabel": "Shipping & returns",
        "secondaryButtonHref": "/shipping-returns",
        "variant": "primary"
      },
      "previewImage": ".eldra/previews/cta.png"
    },
    {
      "apiId": "faq",
      "name": "FAQ",
      "description": "Frequently asked questions as disclosure widgets.",
      "icon": "help-circle",
      "category": "content",
      "version": 1,
      "fields": [
        {
          "fieldId": "heading",
          "name": "Heading",
          "type": "string",
          "isTitle": true,
          "localized": true
        },
        {
          "fieldId": "items",
          "name": "Questions",
          "type": "list",
          "metadata": {
            "item": {
              "fieldId": "item",
              "name": "Question",
              "type": "composite",
              "metadata": {
                "fields": [
                  {
                    "fieldId": "question",
                    "name": "Question",
                    "type": "string",
                    "localized": true,
                    "validators": {
                      "required": true
                    }
                  },
                  {
                    "fieldId": "answer",
                    "name": "Answer",
                    "type": "text",
                    "localized": true,
                    "validators": {
                      "required": true
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "mock": {
        "heading": "FAQ",
        "items": [
          {
            "question": "Can I use my own domain?",
            "answer": "Custom domains are on the roadmap; pages.dev works today."
          }
        ]
      },
      "previewImage": ".eldra/previews/faq.png"
    },
    {
      "apiId": "feature-grid",
      "name": "Feature grid",
      "description": "Grid of features with icon, title and description.",
      "icon": "grid-dots",
      "category": "marketing",
      "version": 1,
      "fields": [
        {
          "fieldId": "heading",
          "name": "Heading",
          "type": "string",
          "isTitle": true,
          "localized": true
        },
        {
          "fieldId": "features",
          "name": "Features",
          "type": "list",
          "metadata": {
            "item": {
              "fieldId": "feature",
              "name": "Feature",
              "type": "composite",
              "metadata": {
                "fields": [
                  {
                    "fieldId": "icon",
                    "name": "Icon",
                    "type": "tabler-icon"
                  },
                  {
                    "fieldId": "title",
                    "name": "Title",
                    "type": "string",
                    "localized": true,
                    "validators": {
                      "required": true
                    }
                  },
                  {
                    "fieldId": "description",
                    "name": "Description",
                    "type": "text",
                    "localized": true
                  }
                ]
              }
            }
          }
        }
      ],
      "mock": {
        "heading": "Why Eldra",
        "features": [
          {
            "icon": "bolt",
            "title": "Fast",
            "description": "Static builds on a global edge."
          },
          {
            "icon": "lock",
            "title": "Secure",
            "description": "Sandboxed previews, no secrets in builds."
          }
        ]
      },
      "previewImage": ".eldra/previews/feature-grid.png"
    },
    {
      "apiId": "footer",
      "name": "Footer",
      "description": "Site footer with brand, link groups, a newsletter zone and a legal line.",
      "icon": "layout-bottombar",
      "category": "structure",
      "version": 1,
      "fields": [
        {
          "fieldId": "brand",
          "name": "Brand",
          "type": "string",
          "isTitle": true,
          "localized": true,
          "validators": {
            "required": true
          }
        },
        {
          "fieldId": "description",
          "name": "Description",
          "type": "text",
          "localized": true
        },
        {
          "fieldId": "groups",
          "name": "Link groups",
          "type": "list",
          "metadata": {
            "item": {
              "fieldId": "group",
              "name": "Group",
              "type": "composite",
              "metadata": {
                "fields": [
                  {
                    "fieldId": "title",
                    "name": "Title",
                    "type": "string",
                    "localized": true,
                    "validators": {
                      "required": true
                    }
                  },
                  {
                    "fieldId": "links",
                    "name": "Links",
                    "type": "list",
                    "metadata": {
                      "item": {
                        "fieldId": "link",
                        "name": "Link",
                        "type": "composite",
                        "metadata": {
                          "fields": [
                            {
                              "fieldId": "label",
                              "name": "Label",
                              "type": "string",
                              "localized": true,
                              "validators": {
                                "required": true
                              }
                            },
                            {
                              "fieldId": "href",
                              "name": "URL",
                              "type": "string",
                              "validators": {
                                "required": true
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "fieldId": "legal",
          "name": "Legal line",
          "type": "string",
          "localized": true
        },
        {
          "fieldId": "variant",
          "name": "Variant",
          "type": "select",
          "metadata": {
            "options": [
              "default",
              "minimal"
            ]
          }
        }
      ],
      "slots": [
        {
          "id": "newsletter",
          "label": "Newsletter signup",
          "description": "Optional signup form rendered above the legal line.",
          "maxItems": 1
        }
      ],
      "mock": {
        "brand": "Northwind Goods",
        "description": "Thoughtfully made home and lifestyle goods, built to last and easy to love.",
        "groups": [
