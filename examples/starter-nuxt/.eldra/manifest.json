    },
    {
      "apiId": "hero",
      "name": "Hero",
      "description": "Top-of-page banner with heading, supporting text, image and calls to action.",
      "icon": "layout-dashboard",
      "category": "marketing",
      "version": 1,
      "groups": [
        {
          "groupId": "content",
          "name": "Content",
          "defaultOpen": true
        },
        {
          "groupId": "action",
          "name": "Calls to action"
        }
      ],
      "fields": [
        {
          "fieldId": "eyebrow",
          "name": "Eyebrow",
          "type": "string",
          "groupId": "content",
          "localized": true,
          "validators": {
            "maxLength": 60
          }
        },
        {
          "fieldId": "heading",
          "name": "Heading",
          "type": "string",
          "groupId": "content",
          "isTitle": true,
          "localized": true,
          "validators": {
            "required": true,
            "maxLength": 120
          }
        },
        {
          "fieldId": "subheading",
          "name": "Subheading",
          "type": "text",
          "groupId": "content",
          "localized": true,
          "validators": {
            "maxLength": 300
          }
        },
        {
          "fieldId": "image",
          "name": "Image",
          "type": "media",
          "groupId": "content",
          "metadata": {
            "multiple": false,
            "framing": true
          }
        },
        {
          "fieldId": "variant",
          "name": "Variant",
          "type": "select",
          "groupId": "content",
          "metadata": {
            "options": [
              "image-right",
