{
  "apiId": "image",
  "name": "Image",
  "description": "Single framed image with an optional caption.",
  "icon": "photo",
  "category": "content",
  "version": 1,
  "fields": [
    {
      "fieldId": "image",
      "name": "Image",
      "type": "media",
