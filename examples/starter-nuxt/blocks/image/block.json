    },
    {
      "fieldId": "caption",
      "name": "Caption",
      "type": "string",
      "isTitle": true,
      "localized": true
    },
    {
      "fieldId": "aspect",
      "name": "Aspect ratio",
      "type": "select",
      "metadata": { "options": ["auto", "16/9", "4/3", "1/1", "3/4"] }
    },
    {
      "fieldId": "width",
      "name": "Width",
      "type": "select",
      "metadata": { "options": ["narrow", "content", "wide", "full"] }
    }
  ]
}
