{
  "apiId": "footer",
  "name": "Footer",
  "description": "Site footer with brand, link groups, a newsletter zone and a legal line.",
  "icon": "layout-bottombar",
  "category": "structure",
  "version": 1,
  "fields": [
    {
      "fieldId": "brand",
      "name": "Brand",
      "type": "string",
      "isTitle": true,
      "localized": true,
      "validators": { "required": true }
    },
    { "fieldId": "description", "name": "Description", "type": "text", "localized": true },
    {
      "fieldId": "groups",
      "name": "Link groups",
      "type": "list",
      "metadata": {
        "item": {
          "fieldId": "group",
          "name": "Group",
          "type": "composite",
          "metadata": {
            "fields": [
              {
                "fieldId": "title",
                "name": "Title",
                "type": "string",
                "localized": true,
                "validators": { "required": true }
              },
              {
                "fieldId": "links",
                "name": "Links",
                "type": "list",
                "metadata": {
                  "item": {
                    "fieldId": "link",
                    "name": "Link",
                    "type": "composite",
                    "metadata": {
                      "fields": [
                        {
                          "fieldId": "label",
                          "name": "Label",
                          "type": "string",
                          "localized": true,
                          "validators": { "required": true }
                        },
                        {
                          "fieldId": "href",
                          "name": "URL",
                          "type": "string",
                          "validators": { "required": true }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    { "fieldId": "legal", "name": "Legal line", "type": "string", "localized": true },
    {
      "fieldId": "variant",
      "name": "Variant",
      "type": "select",
      "metadata": { "options": ["default", "minimal"] }
    }
  ],
  "slots": [
    {
      "id": "newsletter",
      "label": "Newsletter signup",
      "description": "Optional signup form rendered above the legal line.",
      "maxItems": 1
    }
  ]
}
