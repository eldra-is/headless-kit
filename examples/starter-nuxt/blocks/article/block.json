{
  "apiId": "article",
  "name": "Article",
  "description": "Long-form rich text with a heading, meta line and lead paragraph.",
  "icon": "article",
  "category": "content",
  "version": 1,
  "fields": [
    {
      "fieldId": "heading",
      "name": "Heading",
      "type": "string",
      "isTitle": true,
      "localized": true,
      "validators": { "required": true }
    },
    { "fieldId": "meta", "name": "Meta line", "type": "string", "localized": true },
    { "fieldId": "lead", "name": "Lead paragraph", "type": "text", "localized": true },
    {
      "fieldId": "body",
      "name": "Body",
      "type": "rich-text",
      "localized": true,
      "validators": { "required": true },
      "metadata": {
        "toolbar": [
          "heading",
          "bold",
          "italic",
          "link",
          "bulletList",
          "orderedList",
          "blockquote",
          "codeBlock",
          "image"
        ]
      }
    },
    {
      "fieldId": "width",
      "name": "Width",
      "type": "select",
      "metadata": { "options": ["narrow", "content"] }
    }
  ]
}
