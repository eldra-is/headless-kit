{
  "apiId": "split-content",
  "name": "Split content",
  "description": "Rows of image and text that alternate sides, for an \"our process\" or \"about the materials\" story.",
  "icon": "layout-columns",
  "category": "marketing",
  "version": 1,
  "fields": [
    {
      "fieldId": "startWith",
      "name": "Start with",
      "type": "select",
      "helpText": "image-left is the default. Only the first row's image side — rows then alternate.",
      "metadata": { "options": ["image-left", "image-right"] },
      "validators": { "required": true }
    },
    {
      "fieldId": "rows",
      "name": "Rows",
      "type": "list",
      "description": "1–6 rows (the editor warns above 6).",
      "metadata": {
        "item": {
          "fieldId": "row",
          "name": "Row",
          "type": "composite",
          "metadata": {
            "fields": [
              {
                "fieldId": "image",
                "name": "Image",
                "type": "media",
                "metadata": { "multiple": false, "framing": true }
              },
              {
                "fieldId": "eyebrow",
                "name": "Eyebrow",
                "type": "string",
                "localized": true
              },
              {
                "fieldId": "heading",
                "name": "Heading",
                "type": "string",
                "localized": true,
                "validators": { "required": true }
              },
              {
                "fieldId": "text",
                "name": "Text",
                "type": "rich-text",
                "localized": true,
                "metadata": {
                  "toolbar": ["bold", "italic", "link", "undo", "redo"]
                }
              },
              {
                "fieldId": "linkLabel",
                "name": "Link label",
                "type": "string",
                "localized": true
              },
              { "fieldId": "href", "name": "Link", "type": "string" }
            ]
          }
        }
      }
    }
  ]
}
