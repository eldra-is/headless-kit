{
  "apiId": "navigation",
  "name": "Navigation",
  "description": "Site header with brand, primary links and an optional call to action. Reused across pages via Add existing.",
  "icon": "menu-2",
  "category": "structure",
  "version": 1,
  "fields": [
    {
      "fieldId": "brand",
      "name": "Brand",
      "type": "string",
      "isTitle": true,
      "localized": true,
      "validators": { "required": true }
    },
    {
      "fieldId": "logo",
      "name": "Logo",
      "type": "media",
      "metadata": { "multiple": false }
    },
    {
      "fieldId": "links",
      "name": "Links",
      "type": "list",
      "metadata": {
        "item": {
          "fieldId": "link",
          "name": "Link",
          "type": "composite",
          "metadata": {
            "fields": [
              {
                "fieldId": "label",
                "name": "Label",
                "type": "string",
                "localized": true,
                "validators": { "required": true }
              },
              {
                "fieldId": "href",
                "name": "URL",
                "type": "string",
                "validators": { "required": true }
              }
            ]
          }
        }
      }
    },
    {
      "fieldId": "ctaLabel",
      "name": "Button label",
      "type": "string",
      "localized": true
    },
    { "fieldId": "ctaHref", "name": "Button link", "type": "string" },
    { "fieldId": "sticky", "name": "Stick to top on scroll", "type": "bool", "default": false },
    {
      "fieldId": "variant",
      "name": "Variant",
      "type": "select",
      "metadata": { "options": ["default", "centered", "minimal"] }
    }
  ]
}
