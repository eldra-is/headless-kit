{
  "apiId": "navigation",
  "name": "Header",
  "description": "The store's top bar: brand, primary links with optional mega-menus, search, account, cart and one call to action.",
  "icon": "layout-navbar",
  "category": "structure",
  "version": 3,
  "groups": [
    {
      "groupId": "brand",
      "name": "Brand"
    },
    {
      "groupId": "navigation",
      "name": "Navigation"
    },
    {
      "groupId": "actions",
      "name": "Actions"
    }
  ],
  "migrations": [
    {
      "version": 2,
      "renames": [
        {
          "from": "brand",
          "to": "brandText"
        },
        {
          "from": "logo",
          "to": "brandLogo"
        }
      ]
    },
    {
      "version": 3,
      "renames": [],
      "convertToLink": [
        {
          "from": "links",
          "to": "links",
          "shape": "list",
          "label": "label",
          "url": "href",
          "children": {
            "from": "menuLinks",
            "group": "group"
          }
        },
        {
          "from": "ctaHref",
          "to": "cta",
          "shape": "string",
          "label": "ctaLabel"
        }
      ]
    }
  ],
  "fields": [
    {
      "fieldId": "variant",
      "name": "Variant",
      "type": "select",
      "groupId": "navigation",
      "metadata": {
        "options": ["default", "centered", "minimal"]
      },
      "validators": {
        "required": true
      },
      "helpText": "default: brand, inline links and actions. centered: brand centred with links on a second row. minimal: brand, search, cart and a Menu button at every width."
    },
    {
      "fieldId": "brandText",
      "name": "Brand",
      "type": "string",
      "groupId": "brand",
      "isTitle": true,
      "localized": true,
      "validators": {
        "required": true,
        "maxLength": 20
      },
      "helpText": "Shown as the wordmark when no logo is set. Keep it under 20 characters — it never wraps."
    },
    {
      "fieldId": "brandLogo",
      "name": "Logo",
      "type": "media",
      "groupId": "brand",
      "metadata": {
        "multiple": false
      },
      "helpText": "SVG or PNG. Replaces the wordmark. Shown 2rem tall, max 10rem wide."
    },
    {
      "fieldId": "links",
      "name": "Links",
      "type": "list",
      "groupId": "navigation",
      "helpText": "Primary links. 3 to 6 recommended; more than 6 may overflow at 64–80rem. Give a link children to turn it into a mega-menu: consecutive children sharing the same Group form one column, in order — up to 4 groups × 8 links.",
      "metadata": {
        "item": {
          "fieldId": "link",
          "name": "Link",
          "type": "link",
          "localized": true,
          "metadata": {
            "tree": true,
            "kinds": ["product", "collection", "category", "page", "entry", "url", "none"]
          }
        }
      }
    },
    {
      "fieldId": "showSearch",
      "name": "Show search",
      "type": "bool",
      "groupId": "actions",
      "default": true,
      "helpText": "Opens Search (also on / and ⌘K / Ctrl+K)."
    },
    {
      "fieldId": "searchStyle",
      "name": "Search style",
      "type": "select",
      "groupId": "actions",
      "metadata": {
        "options": ["icon", "field", "inline"]
      },
      "helpText": "icon: a ghost icon button. field: a pill field-like trigger, from 64rem only. inline: a live search bar in the bar, centered variant only, from 64rem only."
    },
    {
      "fieldId": "showAccount",
      "name": "Show account",
      "type": "bool",
      "groupId": "actions",
      "default": true,
      "helpText": "Shown in the bar from 64rem, and always in the drawer."
    },
    {
      "fieldId": "ctaLabel",
      "name": "Button label",
      "type": "string",
      "groupId": "actions",
      "localized": true
    },
    {
      "fieldId": "cta",
      "name": "Button link",
      "type": "link",
      "groupId": "actions",
      "localized": true,
      "metadata": {
        "kinds": ["product", "collection", "category", "entry", "page", "url"]
      }
    },
    {
      "fieldId": "sticky",
      "name": "Stick to top on scroll",
      "type": "bool",
      "groupId": "actions",
      "default": true
    },
    {
      "fieldId": "transparentOverHero",
      "name": "Transparent over hero",
      "type": "bool",
      "groupId": "actions",
      "default": false,
      "helpText": "Only takes effect when the next block is a Hero with the image-background variant."
    }
  ]
}
