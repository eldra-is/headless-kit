      "label": "Stoneware",
      "heading": "Made for the dishwasher",
      "body": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Our stoneware is fired to 2,264°F, so it is dishwasher, microwave and oven safe to 400°F. Pieces with a gold rim or raw clay foot are hand wash only."
              }
            ]
          }
        ]
      },
      "linkLabel": "Shop stoneware",
      "href": "/collections/ceramics"
    },
    {
      "label": "Wood & boards",
      "heading": "Oil it when it looks thirsty",
      "body": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Wash with warm soapy water, dry upright and never soak. Every few weeks, rub in a little board oil and leave it overnight."
              }
            ]
          }
        ]
      },
      "linkLabel": "Shop board oil",
      "href": "/collections/kitchen"
