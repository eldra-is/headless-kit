{
  "apiId": "tabs",
  "name": "Tabs",
  "description": "Related content — care guides, materials, \"how it works\" by product type — grouped into tabs, each with a heading, rich text, an optional image and a link.",
  "icon": "layout-navbar-collapse",
  "category": "content",
  "version": 1,
  "fields": [
    {
      "fieldId": "heading",
      "name": "Heading",
      "type": "string",
      "isTitle": true,
      "localized": true,
      "helpText": "Rendered as the h2. It also labels the tab list.",
      "validators": { "required": true }
    },
    {
      "fieldId": "intro",
      "name": "Intro",
      "type": "text",
      "localized": true
    },
    {
      "fieldId": "tabs",
      "name": "Tabs",
      "type": "list",
      "description": "2-6 tabs.",
      "metadata": {
        "item": {
          "fieldId": "tab",
          "name": "Tab",
          "type": "composite",
          "metadata": {
            "fields": [
              {
                "fieldId": "label",
                "name": "Label",
                "type": "string",
                "localized": true,
                "helpText": "Tab text, 1 to 3 words.",
                "validators": { "required": true, "maxLength": 24 }
              },
              {
                "fieldId": "heading",
                "name": "Heading",
                "type": "string",
                "localized": true,
                "helpText": "Rendered as an h3 inside the panel.",
                "validators": { "required": true }
              },
              {
                "fieldId": "body",
                "name": "Body",
                "type": "rich-text",
                "localized": true,
                "helpText": "Paragraphs, bulleted lists, bold and links.",
                "metadata": {
                  "toolbar": ["bold", "italic", "link", "bulletList", "undo", "redo"]
                },
                "validators": { "required": true }
              },
              {
                "fieldId": "image",
                "name": "Image",
                "type": "media",
                "helpText": "4:3 with a focal point. When missing, the panel is text-only.",
                "metadata": { "multiple": false, "framing": true }
              },
              {
                "fieldId": "linkLabel",
                "name": "Link label",
                "type": "string",
                "localized": true
              },
              { "fieldId": "href", "name": "Link", "type": "string" }
            ]
          }
        }
      }
    },
    {
      "fieldId": "defaultTab",
      "name": "Default tab",
      "type": "int",
      "default": 1,
      "helpText": "1-based index of the tab selected on load."
    },
    {
      "fieldId": "sectionBackground",
      "name": "Section background",
      "type": "select",
      "helpText": "none is the default.",
      "metadata": { "options": ["none", "surface", "surface-strong"] }
    }
  ]
}
