{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "initial-version": "0.1.0",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": true,
  "separate-pull-requests": false,
  "packages": {
    "packages/sdk": {
      "component": "sdk",
      "package-name": "@eldrajs/sdk",
      "changelog-path": "RELEASE-NOTES.md"
    },
    "packages/rich-text": {
      "component": "rich-text",
      "package-name": "@eldrajs/rich-text",
      "changelog-path": "RELEASE-NOTES.md"
    },
    "packages/vue": {
      "component": "vue",
      "package-name": "@eldrajs/vue",
      "changelog-path": "RELEASE-NOTES.md"
    },
    "packages/theme-core": {
      "component": "theme-core",
      "package-name": "@eldrajs/theme-core",
      "changelog-path": "RELEASE-NOTES.md"
    },
    "packages/theme-vue": {
      "component": "theme-vue",
      "package-name": "@eldrajs/theme-vue",
      "changelog-path": "RELEASE-NOTES.md"
    },
    "packages/vite-plugin-theme": {
      "component": "vite-plugin-theme",
      "package-name": "@eldrajs/vite-plugin-theme",
      "changelog-path": "RELEASE-NOTES.md"
    },
    "packages/theme-cli": {
      "component": "theme-cli",
      "package-name": "@eldrajs/theme-cli",
      "changelog-path": "RELEASE-NOTES.md"
    },
    "packages/theme-nuxt": {
      "component": "theme-nuxt",
      "package-name": "@eldrajs/theme-nuxt",
      "changelog-path": "RELEASE-NOTES.md"
    },
    "packages/ui": {
      "component": "ui",
      "package-name": "@eldrajs/ui",
      "changelog-path": "RELEASE-NOTES.md"
    }
  },
  "plugins": ["node-workspace"]
}
